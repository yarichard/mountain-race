METEOFRANCE_USER=
METEOFRANCE_PASS=

# LLM provider for equipment extraction and natural-language intent parsing
# Supported values: "gemini" (default), "openai", "ollama"
LLM_PROVIDER=gemini

GEMINI_API_KEY=xxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

HF_TOKEN=xxxx